<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,new_device,">
  <rule id="100020" level="7">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^6416$</field>
    <description>New device connected to a monitored Windows host</description>
  </rule>
</group>

<group name="local,brute_force,">
  <rule id="100021" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>Possible brute-force: 5+ failed logins in 60 seconds</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>
</group>
